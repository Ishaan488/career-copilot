{
  "name": "career-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --hostname 127.0.0.1 --port 3000",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:all": "concurrently -n web,worker -c blue,magenta \"npm run dev\" \"npm run dev:worker\"",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "start:worker": "tsx src/worker/index.ts",
    "start:all": "concurrently -n web,worker -c blue,magenta \"npm run start\" \"npm run start:worker\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:deps": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run --exclude 'tests/{int,e2e,failure}/**'",
    "test:int": "vitest run --config vitest.config.int.ts",
    "test:e2e": "playwright test",
    "test:failure": "vitest run --config vitest.config.failure.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:reset:test": "tsx scripts/db-reset-test.ts",
    "verify:env": "tsx scripts/verify-env.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@rollup/rollup-win32-x64-msvc": "^4.68.2",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "pg": "^8.13.3",
    "pg-boss": "^10.1.5",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.14.0",
    "tailwind-merge": "^3.0.1",
    "tldts": "^6.1.77",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sanitize-html": "^2.13.0",
    "concurrently": "^9.1.2",
    "dependency-cruiser": "^16.10.0",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.1",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
